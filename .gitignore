# Publish source and public documentation only. New root-level material is private
# until explicitly added below (prevents accidentally committing game inputs/logs).
/*
!/.gitignore
!/README.md
!/BUILDING.md
!/LICENSE
!/THIRD_PARTY.md
!/requirements-audit.txt
!/config/
!/launcher/
!/packaging/
!/probe/
!/runtime/
!/scripts/
!/third_party/
!/docs/
/docs/*
!/docs/CONTROLS.md

